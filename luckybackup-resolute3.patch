@@ -35,11 +35,54 @@ Display a dialog. Adds a new or modifies an existing operation
 #include <QCompleter>
 #include <QDirModel>
 #include <QFileDialog>
+#include <QToolButton>
+#include <QToolTip>
 
 #include "global.h"
 
 #include "textDialog.h"
 
+namespace
+{
+QHBoxLayout *optionWithHelp(QCheckBox *option)
+{
+    QToolButton *help = new QToolButton(option->parentWidget());
+    help->setText(QStringLiteral("?"));
+    help->setToolTip(option->toolTip());
+    help->setAccessibleName(option->text());
+    help->setAccessibleDescription(option->toolTip());
+    QObject::connect(help, &QToolButton::clicked, help, [help]() {
+        QToolTip::showText(help->mapToGlobal(QPoint(0, help->height())),
+                           help->toolTip(), help);
+    });
+
+    QHBoxLayout *row = new QHBoxLayout;
+    row->addWidget(option);
+    row->addWidget(help);
+    row->addStretch();
+    return row;
+}
+
+void addTemplateHelp(QGridLayout *grid, QVBoxLayout *deleteLayout)
+{
+    for (int index = grid->count() - 1; index >= 0; --index)
+    {
+        QCheckBox *option = qobject_cast<QCheckBox *>(grid->itemAt(index)->widget());
+        if (!option || option->isHidden() || option->toolTip().isEmpty())
+            continue;
+
+        int row, column, rowSpan, columnSpan;
+        grid->getItemPosition(index, &row, &column, &rowSpan, &columnSpan);
+        grid->removeWidget(option);
+        grid->addLayout(optionWithHelp(option), row, column, rowSpan, columnSpan);
+    }
+
+    QCheckBox *deleteOption = qobject_cast<QCheckBox *>(deleteLayout->itemAt(0)->widget());
+    deleteLayout->removeWidget(deleteOption);
+    deleteLayout->insertLayout(0, optionWithHelp(deleteOption));
+}
+}
+
